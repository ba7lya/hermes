# Normalize every text file to LF in the working tree on every platform.
* text=auto eol=lf

# Binary files must never be normalized.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.exe  binary
*.dll  binary
*.lib  binary
*.pdb  binary
